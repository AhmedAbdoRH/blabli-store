# Example environment variables for Supabase
# Copy this file to `.env.local` and fill values. Do NOT commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only key (do NOT expose to the browser). Set this in your hosting provider's
# environment variables or in a server-only .env file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Optional: access token you mentioned (store securely, not in the repo)
ACSS_TOKEN=your_acss_token_here
